# DataLens release signing config - TEMPLATE
#
# Copy this to android/keystore.properties and fill in the real values:
#     Copy-Item keystore.properties.example keystore.properties
#
# Generate both files with:
#     powershell -ExecutionPolicy Bypass -File ..\tools\setup-release-key.ps1
#
# keystore.properties is gitignored. Never commit real values, and never
# paste a password into a tracked file, a chat, or an issue.
#
# KEEP THE .jks SAFE. Android requires every future version of an
# installed app to be signed with the identical key. If you lose it you
# cannot update an installed copy - you would have to change the
# applicationId and publish as a new app.

storeFile=keystore/datalens-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=datalens
keyPassword=YOUR_KEY_PASSWORD