# Dependencies (Phase 0 onward)
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Android / Bubblewrap (generated, never commit)
.twa/
android/
*.aab
# Committed APKs are deliberate and added explicitly — this only catches strays
app-release.apk
app-debug.apk
*.keystore
*.jks
!debug.keystore

# Secrets — never commit. Only .env.example and config.example.js belong in the repo.
.env
.env.local
.env*.local

# Runtime config carries the Supabase anon key. Gitignored on purpose so a
# shared repo never carries live project credentials. The anon key is public
# by design, but keeping it out of git means you can rotate or scope it
# without history rewrites.
config.js

# Explicitly deny anything that looks like a server-side key, so a stray
# copy-paste into config.js or a .env file cannot reach the remote.
*GROQ*
*gsk_*
*SLACK*
*slack*
*.webhook

# Firebase
.firebase/
firebase-debug.log
*-debug.log

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local scratch
.tmpcheck.js
*.tmp.js