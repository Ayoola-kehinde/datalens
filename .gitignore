# Dependencies (Phase 0 onward)
node_modules/
.pnpm-store/
.pnp
.pnp.js

# Supabase CLI local state — machine-specific, not part of the project.
# linked-project.json carries the org id and slug, which have no business
# being public.
supabase/.temp/
supabase/.branches/

# Signing material. NEVER commit these.
# The keystore is the app's identity: Android refuses updates signed with
# a different key, so losing it means you can never ship an update to an
# already-installed app. keystore.properties holds its password.
android/keystore.properties
android/*.jks
android/keystore/
*.keystore
*.jks
!debug.keystore

# Build outputs
# dist/* rather than dist/ so the one APK re-included below is reachable:
# git never descends into an excluded directory, so a negation for a file
# inside dist/ would be ignored.
dist/*
build/
.next/
out/
*.tsbuildinfo

# Shipped APKs: build outputs, not source. Reproduce via
# tools/build-apk.ps1 rather than committing each build.
#
# Exception: the current release APK IS committed, deliberately, so the
# external testers can download and install it without building anything.
# Replace this single file on each release (force-add overwrites it) rather
# than adding one per build, which would grow the repo permanently.
release/
*.apk
*.aab
!dist/DataLens-release-v1.0.apk

# ---- Capacitor ----
# www/ is generated by `npm run build` (tools/sync-web.mjs) and is copied
# into the APK by `npx cap copy`. Regenerate rather than commit.
www/

# The android/ project source IS committed so CI can build an APK without
# running `npx cap add android`. Only its generated output is ignored.
android/build/
android/app/build/
android/.gradle/
android/capacitor-cordova-android-plugins/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/local.properties
android/.idea/
*.iml

# Android / Capacitor build artefacts
.twa/
*.aab
# Committed APKs are deliberate and added explicitly — this only catches strays
app-release.apk
app-debug.apk
*.keystore
*.jks
!debug.keystore

# Secrets — never commit. Only .env.example and config.example.js belong in the repo.
.env
.env.local
.env*.local

# config.js IS committed on purpose — it carries only the Supabase URL and
# the anon public key, both of which are designed to be visible. Data is
# protected by Row Level Security, not by keeping the key secret.
#
# config.local.js is for local-only overrides during development and is
# never deployed.
config.local.js

# Server-side secrets must never reach a committed file, whatever it is
# named. These deny rules catch a paste into the wrong place.
*GROQ*
*gsk_*
*SLACK*
*slack*
hooks.slack.com
*.webhook
*.jks
*.keystore

# Firebase
.firebase/
firebase-debug.log
*-debug.log

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local scratch
.tmpcheck.js
*.tmp.js